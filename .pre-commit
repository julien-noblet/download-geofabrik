#!/bin/sh
#
go fmt ./...
go mod tidy

mkdir -p docs/catalogs

cat .README.md1 > README.md
go run ./cmd/download-geofabrik --help >> README.md
cat .README.md2 >> README.md

# Geofabrik
cat << 'EOF' > docs/catalogs/geofabrik.md
# Geofabrik Extracts Catalog

[← Back to README](../../README.md)

- **Service Key**: `geofabrik` (default)
- **Description**: Continents, countries, and regional OpenStreetMap extracts
- **Example**: `download-geofabrik download ile-de-france`

## Available Elements

EOF
go run ./cmd/download-geofabrik list --markdown >> docs/catalogs/geofabrik.md

# OpenStreetMap France
cat << 'EOF' > docs/catalogs/openstreetmap.fr.md
# OpenStreetMap France Extracts Catalog

[← Back to README](../../README.md)

- **Service Key**: `openstreetmap.fr`
- **Description**: High-detail extracts for French regions, departments, and worldwide extracts
- **Example**: `download-geofabrik --service openstreetmap.fr download rhone-alpes`

## Available Elements

EOF
go run ./cmd/download-geofabrik --service "openstreetmap.fr" list --markdown >> docs/catalogs/openstreetmap.fr.md

# BBBike
cat << 'EOF' > docs/catalogs/bbbike.md
# BBBike Extracts Catalog

[← Back to README](../../README.md)

- **Service Key**: `bbbike`
- **Description**: Extracts for 200+ major metropolitan cities worldwide
- **Example**: `download-geofabrik --service bbbike download Berlin`

## Available Elements

EOF
go run ./cmd/download-geofabrik --service "bbbike" list --markdown >> docs/catalogs/bbbike.md

# Geo2day
cat << 'EOF' > docs/catalogs/geo2day.md
